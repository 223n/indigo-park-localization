msgstr ""

#. ftext: RambleyFiles/Voice/ConductorRambley
msgctxt "/2D50BDC948FCA5E081E6D0A85E6F7172"
msgid "Welcome to Rambley’s Railroad! I’m Conductor Rambley!"
msgstr ""

#. ftext: RambleyFiles/Voice/ExplainingInfo
msgctxt "/26BFA643449282ABF39AAFA82B725AB6"
msgid "on about it!"
msgstr ""

#. ftext: RambleyFiles/Voice/ExplainingInfo
msgctxt "/46AB6C524D2092343649E4B1FE00707E"
msgid "ramble"
msgstr ""

#. ftext: RambleyFiles/Voice/ExplainingInfo
msgctxt "/73B2BCBF4C68144C9233EB89863C2EE7"
msgid "Just stop by here and I'll"
msgstr ""

#. ftext: RambleyFiles/Voice/ExplainingInfo
msgctxt "/748FAFB445B1357BE0B9A0AAF7DA6E07"
msgid "If there's anything around the park you wanna ask me about"
msgstr ""

#. ftext: RambleyFiles/Voice/ExplainingInfo
msgctxt "/9D5BC2AA4BE8C263319CC9AC7D0189E2"
msgid "This here's an information kiosk!"
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/08C1C0204F101221B16EA5B9C0104761"
msgid "The park has been inactive for years, employees stopped showing up, guests too… the mascots are… "
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/176825224B2A12437E77FB9EC299C519"
msgid "You must’ve come here because the park matters to you too, right?"
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/2901D6B64B88B1DF37AD18AD963DD981"
msgid " I can see in your facial tracking data that you aren’t opposed to this!"
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/29E9398A4E480181AE707098508EF8BF"
msgid " I’m wasting all of your fun time…"
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/4BBBDEF641B496132E1A15BCE19D44E2"
msgid "but… BUT!! I have an idea! "
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/6B7E09FC48F52A9566F6A0B41FD0CA26"
msgid "I have access to the repair documentation in my database!"
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/6ED3760846E22F4C52A417A847115713"
msgid "Would you… be willing to help me restore the park?"
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/75A92DE04A0BFC4061DE31945E5C9659"
msgid "transparency is an important part of our policy here at indigo park so…"
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/76C6F0C84FAD26CBAC49CE8F2E0E8421"
msgid "Oooh, I’m so excited! Let’s get this place back in business!"
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/7EA68FE54873195280A40684E30004A9"
msgid "Here we have plenty of amenities and— ahh— okay okay. "
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/848260944C0AEB530F3C7493DB4D1D09"
msgid "I need to be honest about something. "
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/9F6F77ED4B29903E9FE1319853A01C3A"
msgid "I just can’t execute most tasks without authorization from a human user…"
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/A902B0B64CF1A0BE20D3F0A23AB58ED5"
msgid "but I was confined to the entrance for so long, I didn’t realize just how much disrepair the park has… fallen into."
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/B2016C014F7A526B4FED3EB1FD3C0345"
msgid "Ehh, sorry for the inconvenience…"
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/C615E23A46540C702608E6A2FBA1C077"
msgid "I just was so excited to see a visitor and I wanted to be sure you were given the best experience possible!"
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/C97675EF4AE19B3B96512B92F4F137D3"
msgid "Welcome to the Rambley's Ranglers (registered) room!"
msgstr ""

#. ftext: RambleyFiles/Voice/FinalMonologue
msgctxt "/EA82C583437B3D865CB5799154964505"
msgid "I can see in your facial tracking that you're scared- CONFUSED— angry-y-y upset-…"
msgstr ""

#. ftext: RambleyFiles/Voice/HereYouGoBuddy
msgctxt "/3205C1234BAB07D2135037AA176AF22A"
msgid "that also doubles as a pedometer, heart monitor, and mood ring!"
