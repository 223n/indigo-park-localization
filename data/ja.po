#. stringtable: ST_Menu
msgctxt "ST_Menu/AudioSettings_MasterVolume_Subtext"
msgid "Adjust the volume of <h>all music, non-player voices and sound effects</> played throughout the game.\r\n\r\n<b>Default Value: 100</>"
