msgctxt "/2E3B55A34B4CEA69D1BA2491CDE46472"
msgid "Oops! Looks like Jetstream Junction’s being tuned up!"
msgstr ""

#. ftext: RambleyFiles/Voice/JetstreamJunctionislockedup
msgctxt "/B50C7EB246B8FEFA0731928ACD67E7F1"
msgid " Last I checked, there’s a security office in the back of the theater."
msgstr ""

