msgctxt "/66B7E2C1447AB17C65B03589D362FC82"
msgid "Your facial data suggests you may be a bit older than the target audience for this ride,"
msgstr ""

#. ftext: RambleyFiles/Voice/ILikeTrains
msgctxt "/729442494D27B93488D4AB96BBEBB404"
msgid "but it’s one of my favorites!"
msgstr ""

#. ftext: RambleyFiles/Voice/ILikeTrains
msgctxt "/A58C415F45A500F79BD0CF8991A5DA60"
msgid "‘Cause I like trains!"
msgstr ""

#. ftext: RambleyFiles/Voice/ILikeTrains
msgctxt "/C1F625A84936E3488DFB9B8A43761BA6"
msgid "Do you know why RAMBLEY the Raccoon loves RAMBLEY’s Railroad?"
msgstr ""

