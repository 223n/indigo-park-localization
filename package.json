{
  "name": "indigo-park-localization",
  "version": "0.6.0",
  "private": true,
  "description": "Steam 版のゲーム「Indigo Park」の非公式な日本語化 MOD。訳した文と、それをゲームへ適用する仕組みを管理する。",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "npm run lint:md && npm run lint:ja",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:ja": "textlint .",
    "lint:ja:fix": "textlint --fix ."
  },
  "devDependencies": {
    "@223n/lint-config-ja": "^1.1.0",
    "markdownlint-cli2": "^0.23.2",
    "textlint": "^15.8.0"
  },
  "overrides": {
    "smol-toml": "^1.7.1"
  }
}
